              "mode": "raw",
              "raw": "{\n  \"customer\": \"\",\n  \"equipmentModel\": \"AX-500\",\n  \"description\": \"short\",\n  \"serviceDate\": \"2099-01-01\",\n  \"warrantyStatus\": \"MAYBE\"\n}"
