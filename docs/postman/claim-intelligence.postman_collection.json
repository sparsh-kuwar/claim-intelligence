                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"routed to human review\", () => pm.expect(b.validationStatus).to.eql(\"NEEDS_REVIEW\"));",
                  "pm.test(\"R2 low confidence failed\", () => pm.expect(b.validation.failedRules).to.include(\"R2\"));",
                  "pm.test(\"per-field confidence\", () => pm.expect(b.aiAnalysis.category.confidence).to.be.a(\"number\"));",
                  "pm.test(\"final columns empty before approval\", () => pm.expect(b.category).to.eql(null));"
                ]
