    {
      "name": "1. Intake",
      "item": [
        {
          "name": "Create claim (JSON) - PDF example",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/claims",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "claims"
              ]
            },
            "description": "Creates a claim; returns Claim ID, submission timestamp, status PROCESSING.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer\": \"ABC Manufacturing\",\n  \"equipmentModel\": \"AX-500\",\n  \"serialNumber\": \"SN10231\",\n  \"description\": \"Router AX500 has intermittent connectivity. Customer replaced the power module twice. Device is still under warranty. Technician suspects a hardware failure.\",\n  \"serviceDate\": \"2026-09-20\",\n  \"warrantyStatus\": \"UNDER_WARRANTY\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test(\"has claimId\", () => pm.expect(b.claimId).to.match(/^CLM-\\d+$/));",
                  "pm.test(\"status PROCESSING\", () => pm.expect(b.status).to.eql(\"PROCESSING\"));",
                  "pm.test(\"has timestamp\", () => pm.expect(b.submittedAt).to.be.a(\"string\"));",
                  "pm.collectionVariables.set(\"claimId\", b.claimId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create claim (multipart + optional attachment)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "customer",
                  "value": "ABC Manufacturing",
                  "type": "text"
                },
                {
                  "key": "equipmentModel",
                  "value": "AX-500",
                  "type": "text"
                },
                {
                  "key": "serialNumber",
                  "value": "SN10231",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "Router AX500 has intermittent connectivity. Customer replaced the power module twice. Device is still under warranty. Technician suspects a hardware failure.",
                  "type": "text"
                },
                {
                  "key": "serviceDate",
                  "value": "2026-09-20",
                  "type": "text"
                },
                {
                  "key": "warrantyStatus",
                  "value": "UNDER_WARRANTY",
                  "type": "text"
                },
                {
                  "key": "attachment",
                  "type": "file",
                  "src": [],
                  "disabled": true,
                  "description": "enable and pick a PDF/PNG/JPG/TXT <= 5MB"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/claims",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "claims"
              ]
            },
            "description": "Same as JSON create, as multipart/form-data. Enable the attachment row to upload a file."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create claim - validation errors (422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
