# Copy to .env and adjust. Never commit .env.

# PostgreSQL connection (docker-compose.yml at repo root starts one on 5432)
DATABASE_URL=postgresql+psycopg://claims:claims@localhost:5432/claims
TEST_DATABASE_URL=postgresql+psycopg://claims:claims@localhost:5432/claims_test

# Confidence threshold (0-100). A decision-critical field below this -> HUMAN REVIEW.
CONFIDENCE_THRESHOLD=80

# AI provider: rule_based | anthropic | openai
#   rule_based  -> deterministic NLP simulation, no key required (default)
#   anthropic / openai -> real LLM; falls back to rule_based on any error
AI_PROVIDER=rule_based
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30

# Frontend origin allowed by CORS
CORS_ORIGINS=http://localhost:5173

# Attachments
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
